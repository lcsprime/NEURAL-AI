{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neural-ai-computing",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "none",
    "run_worker_first": ["/health", "/api/visits"]
  },
  "workers_dev": true
}
